 "diagnostics": [
  {
   "th": "พิมพ์ทรงของวัดระฆังตามวิกิพีเดียไทย ๖ พิมพ์: พิมพ์ทรงพระประธาน (พิมพ์ใหญ่) · ทรงเจดีย์ · ฐานแซม · เกศบัวตูม · ปรกโพธิ์ · เศียรบาตรอกครุฑ",
   "en": "Six Wat Rakhang mould-types per Thai Wikipedia: Phra Prathan / Phim Yai (large), Chedi, Than Saem, Ket Bua Tum, Prok Pho, Sian Bat Ok Khrut. The trade usually counts five, folding the last into the others",
   "source": "s:th-wiki-somdet-rakhang",
   "tier": "cited"
  },
  {
   "th": "มวลสารหลักคือปูนขาวเปลือกหอย ผสมข้าวสุก กล้วย น้ำมัน ทราย ผงวิเศษ ๕ ประการ และว่านยา ๑๐๘",
   "en": "Body is calcined shell-lime bound with cooked rice, banana, oil and sand, carrying the five sacred powders (ผงวิเศษ ๕ ประการ) and 108 herbal ingredients",
   "source": "s:th-wiki-somdet-rakhang",
   "tier": "cited"
  },
  {
   "th": "เนื้อผงขาวอมเหลือง มีมวลสารเป็นเม็ดหลากสี",
   "en": "Off-white to yellowish powder body flecked with coloured inclusions; the material is the first gate, the mould the second",
   "source": "s:vault-materials",
   "tier": "tradition"
  },
  {
   "th": "ผิวมีคราบ (surface crust) ตามอายุ — เนื้อผงไม่เกิดสนิม",
   "en": "Age reads as a surface crust, never as rust: the powder body's dating signal per the material axis",
   "source": "s:vault-materials",
   "tier": "catalogue"
  },
  {
   "th": "หมวดเนื้อผงเป็นหมวดที่ถูกทำเลียนแบบมากที่สุด จึงเป็นหมวดที่ต้องส่องให้ถ้วนถี่",
   "en": "The most reproduced material category in the trade; a careful eye is the norm here, which is a statement about the category, never about an object",
   "source": "s:vault-materials",
   "tier": "catalogue"
  }
 ],
 "confusable_with": [
  {
   "id": "hun-phayon",
   "tell_th": "พระสมเด็จเป็นองค์พระในซุ้ม ไม่มีผู้อยู่ ไม่ต้องเลี้ยง · หุ่นพยนต์เป็นรูปคนหรือหุ่นฟาง มีสิ่งที่ถูกปลุกให้อยู่ ต้องเซ่นทุกวัน",
   "tell_en": "A somdej is a Buddha in an arch with nobody home and nothing owed; a hun payon is a man-shaped figure of earth, straw or cloth that has been animated and is fed daily. Different class, different keeping, different provenance question."
  },
  {
   "id": "khun-phaen",
   "tell_th": "ขุนแผนเป็นพิมพ์ทรงห้าเหลี่ยม/ซุ้มเรือนแก้วแบบอยุธยา",
   "tell_en": "Khun Phaen tablets use an Ayutthaya-style pentagonal or ruean-kaeo arch; the somdej form is a straight-edged rectangle with a bell-glass arch"
  },
  {
   "id": "phra-phong-bai-lan",
   "tell_th": "ผงใบลานเนื้อดำเทาจากใบลานเผา ส่วนพระสมเด็จเนื้อขาว",
   "tell_en": "Palm-leaf-ash tablets are black-grey; the somdej body is white to cream"
  }
 ],
